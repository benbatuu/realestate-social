{
  "name": "app-root",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "services:up": "docker compose up -d --wait && pnpm --filter @app/api run storage:init",
    "services:down": "docker compose down",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @app/shared run build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @app/api --filter @app/web run dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "test:unit": "pnpm build:shared && pnpm -r run test:unit",
    "db:generate": "pnpm --filter @app/api run db:generate",
    "db:migrate": "pnpm --filter @app/api run db:migrate",
    "db:deploy": "pnpm --filter @app/api run db:deploy",
    "db:seed": "pnpm --filter @app/api run db:seed",
    "test:e2e": "pnpm build:shared && pnpm --filter @app/web run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
