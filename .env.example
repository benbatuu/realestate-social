# Copy to .env and adjust. Placeholders only: never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

# Ports (3000/4000 from the blueprint were busy on the dev machine)
WEB_PORT=3100
API_PORT=4100
APP_URL=http://localhost:3100
API_URL=http://localhost:4100

# Local services from docker-compose.yml
DATABASE_URL=postgresql://app:app@localhost:55432/app?schema=public
# Integration/E2E tests use their own database in the same container (created automatically)
TEST_DATABASE_URL=postgresql://app:app@localhost:55432/app_test?schema=public
REDIS_URL=redis://localhost:56379

OBJECT_STORAGE_ENDPOINT=http://localhost:58333
OBJECT_STORAGE_BUCKET=app-dev
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=devaccesskey
OBJECT_STORAGE_SECRET_KEY=devsecretkey
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Browser-facing storage host for signed URLs (defaults to OBJECT_STORAGE_ENDPOINT)
OBJECT_STORAGE_PUBLIC_ENDPOINT=
# Integration/E2E tests use their own bucket (created automatically)
TEST_OBJECT_STORAGE_BUCKET=app-test

# Imports and photos
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=5000
IMPORT_TTL_HOURS=24
PHOTO_MAX_FILE_MB=20
PHOTO_MAX_PER_PROPERTY=60

# Secrets (generate locally, e.g. `openssl rand -base64 32`)
AUTH_SECRET=BgZ5deLelpJeOOC8MkQFBS7sGv0Wr2J1HpojSg6uTXc=
ENCRYPTION_KEY=6KcqmzSwb5wyu90AhnafWznUkIX2KhWFYT7NLNKu81Q=

# Providers. `mock` for development and tests. A real provider needs its key, or the API will not start.
PROVIDER_I2V=mock
PROVIDER_LLM=mock
PROVIDER_TTS=mock
PROVIDER_MUSIC=mock
FAL_API_KEY=
FAL_KLING_MODEL=fal-ai/kling-video/v3/pro/image-to-video
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
MUSIC_CATALOG_PATH=

# Plan 08 (AI video). Set PROVIDER_I2V and PROVIDER_LLM to openrouter to use these.
# One OpenRouter key covers the video models and Claude. Model ids must be checked against
# GET https://openrouter.ai/api/v1/videos/models before the first paid call.
OPENROUTER_API_KEY=
I2V_MODEL_PRIMARY=bytedance/seedance-2.5
I2V_MODEL_FALLBACK=google/veo-3.1-fast
I2V_RESOLUTION=1080p
ELEVENLABS_MODEL=eleven_multilingual_v2
# Budget guards. Paid calls stay off until this is true.
AI_PAID_CALLS_ENABLED=false
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=50

# Auth
# Which proxies may set X-Forwarded-For (Express trust proxy). Production: the web tier.
TRUST_PROXY=loopback
SESSION_TTL_DAYS=30
INVITATION_TTL_DAYS=7
# Plan code a new workspace is subscribed to (TRIALING). Empty = no plan (1 seat).
# The blueprint defines no free trial: this is a dev/pilot setting, not a product rule.
SIGNUP_PLAN_CODE=starter

# Providers (not used until later milestones; leave empty)
FAL_API_KEY=
ELEVENLABS_API_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
# CRM connection secrets (LeadPilot signing secret). At least 32 characters; generate a new random value.
INTEGRATION_ENCRYPTION_KEY=
